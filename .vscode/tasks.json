{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug (CMake)",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "linux": {
                "command": "cmake",
                "args": [
                    "--build",
                    "${workspaceFolder}/build/cmake",
                    "--parallel"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "${env:HOME}/CMake/cmake-4.2.1-linux-x86_64/bin:${env:HOME}/.dotnet:${env:PATH}"
                    }
                },
                "problemMatcher": "$gcc"
            },
            "windows": {
                "command": "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -vcvars_ver=14.44 && cmake --build \"${workspaceFolder}\\build\\cmake\" --parallel",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                },
                "problemMatcher": "$msCompile"
            }
        },
        {
            "label": "Build Debug (Premake)",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "linux": {
                "command": "make",
                "args": [
                    "-j$(nproc)",
                    "config=debug"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "${env:HOME}/CMake/cmake-4.2.1-linux-x86_64/bin:${env:HOME}/.dotnet:${env:PATH}"
                    }
                },
                "problemMatcher": "$gcc"
            },
            "windows": {
                "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
                 "args": [
                    "${workspaceFolder}\\Razor.sln",
                    "/p:Configuration=Debug",
                    "-maxcpucount:8"
                ],
                "problemMatcher": "$msCompile"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build Sandbox Scripts (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\Sandbox\\Scripts\\Sandbox.csproj",
                "-c", "Debug",
                "-p:Platform=x64"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"

        },
        {
        "label": "Clean project",
        "type": "shell",
        "command": "cmake --build \"${workspaceFolder}\\build\\cmake\" --target clean-all; if ($LASTEXITCODE -eq 0) { Remove-Item -Recurse -Force \"${workspaceFolder}\\build\\cmake\" }"
        }
    ]
}