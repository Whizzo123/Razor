{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "linux": {
                "command": "make",
                "args": ["config=debug"],
                "options": { "cwd": "${workspaceFolder}" },
                "problemMatcher": "$gcc"
            },
            "windows": {
                "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
                "args": [
                    "${workspaceFolder}\\Razor.sln",
                    "/p:Configuration=Debug"
                ],
                "problemMatcher": "$msCompile"
            }
        }
    ]
}
