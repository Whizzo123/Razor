{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Edge",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Debug",
      "linux": {
        "type": "cppdbg",
        "program": "${workspaceFolder}/bin/Debug-linux-x86_64/Edge/Edge",
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      },
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}/bin/Debug-windows-x86_64/Edge/Edge.exe"
      }
    }
  ]
}
