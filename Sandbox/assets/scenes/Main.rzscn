Scene: Untitled
Entities:
  - Entity: 5
    Transform:
      Position: [200, 700, 0]
      Rotation: [0, 0, 0]
      Scale: [0, 0, 0]
    ScriptComponent:
      []
  - Entity: 4
    Transform:
      Position: [0, 0, 35]
      Rotation: [0, 0, 0]
      Scale: [0, 0, 0]
    ScriptComponent:
      []
    Camera:
      {}
  - Entity: 3
    Transform:
      Position: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0, 0, 0]
    Mesh:
      ModelKey: models/Cube.model
    ScriptComponent:
      - Sandbox.Player:
          ScriptFields:
            - Direction:
                Type: System.Int
                Data: 1
            - Name:
                Type: System.String
                Data: Joe
    BoxBody:
      UseGravity: false
      IsStatic: false
      MotionType: Kinematic
      Mass: 1
    CollisionComponent:
      Trigger: true
  - Entity: 2
    Transform:
      Position: [-10, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0, 0, 0]
    Mesh:
      ModelKey: models/Cube.model
    ScriptComponent:
      - Sandbox.TestBox:
          ScriptFields:
            - Name:
                Type: System.String
                Data: ""
    BoxBody:
      UseGravity: false
      IsStatic: false
      MotionType: Dynamic
      Mass: 1
    CollisionComponent:
      Trigger: true
  - Entity: 1
    Transform:
      Position: [1, 0, -10]
      Rotation: [0, 0, 0]
      Scale: [0, 0, 0]
    DirectionalLight:
      Diffuse: [1, 1, 1]
      Ambient: [1, 1, 1]
      Specular: [1, 1, 1]
      Direction: [1, 0, 0]
    ScriptComponent:
      []
  - Entity: 0
    Transform:
      Position: [10, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [0, 0, 0]
    Mesh:
      ModelKey: models/Cube.model
    ScriptComponent:
      []
    BoxBody:
      UseGravity: false
      IsStatic: false
      MotionType: Dynamic
      Mass: 10000
    CollisionComponent:
      Trigger: true
Systems:
  - Sandbox.PlayerMovement
  - Sandbox.TestBoxBodySystem